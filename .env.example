# Anthropic — powers the content/blog generation agents (app/services/claude.py)
ANTHROPIC_API_KEY=
# Model for content generation. Default claude-sonnet-5; claude-haiku-4-5 is cheaper/faster.
ANTHROPIC_MODEL=claude-sonnet-5
# Set to 0 to skip the humanization (de-AI) rewrite pass on blog content.
ANTHROPIC_HUMANIZE=1

# Gemini — still used by mem0 (app/memory/mem0_client.py); not used for blog generation.
GEMINI_API_KEY=
GITHUB_TOKEN=
RESEND_API_KEY=
VERCEL_DEPLOY_HOOK=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001

# --- Orchestrator (Phase 0+) ---
# Pooled Supabase Postgres connection string (for LangGraph checkpointer + mem0).
# Use the "pooled" URL from Supabase project settings (port 6543), not the direct URL.
ORCHESTRATOR_PG_DSN=

# Redis for the RQ worker queue (replaces APScheduler).
# Local dev:  redis://localhost:6379/0
REDIS_URL=

# Optional: LangSmith tracing (every node + tool call traced).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agenticmvp-orchestrator
LANGCHAIN_TRACING_V2=true

# mem0 model overrides (defaults shown).
MEM0_LLM_MODEL=gemini-2.5-flash
MEM0_EMBED_MODEL=text-embedding-004
MEM0_EMBED_DIMS=1536

# --- Phase 2+ ---
# Encryption key (32 random bytes, base64) for OAuth tokens in social_accounts.
SOCIAL_TOKEN_ENC_KEY=

# --- Phase 3+ (cold outbound calling) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# Comma-separated jurisdictions to hard-block (e.g. EU,US-NY).
COMPLIANCE_JURISDICTION_BLOCKLIST=EU
